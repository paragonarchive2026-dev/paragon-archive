{
  "_fileIdentity": {
    "realFileName": "manifest.webmanifest",
    "expectedProjectPath": "/manifest.webmanifest",
    "role": "PWA install manifest"
  },
  "name": "Paragon Archive",
  "short_name": "Paragon",
  "description": "One archive for Paragon websites, updates, collections, and shared progress.",
  "id": "./paragon-archive.html",
  "start_url": "./paragon-archive.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0b0e",
  "theme_color": "#2563eb",
  "orientation": "any",
  "icons": [
    {
      "src": "assets/icons/paragon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/icons/paragon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "entertainment"
  ],
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "launch_handler": {
    "client_mode": "auto"
  },
  "shortcuts": [
    {
      "name": "Updates",
      "short_name": "Updates",
      "description": "Latest Archive activity",
      "url": "./paragon-archive.html#updates",
      "icons": [
        {
          "src": "assets/icons/paragon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My Account",
      "short_name": "Account",
      "description": "Your Paragon account",
      "url": "./paragon-archive.html#account",
      "icons": [
        {
          "src": "assets/icons/paragon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Community Board",
      "short_name": "Community",
      "description": "Member discussion board",
      "url": "./community-board.html",
      "icons": [
        {
          "src": "assets/icons/paragon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Archive Hub",
      "short_name": "Hub",
      "description": "Documentation and gateway",
      "url": "./paragon-archive-hub.html",
      "icons": [
        {
          "src": "assets/icons/paragon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}